{
  "identifier": "default",
  "description": "Default desktop permissions for Mexemplar",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://localhost:*"
        }
      ]
    }
  ]
}
