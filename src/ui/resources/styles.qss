/* Mexemplar 全局样式 (Claude 风格) */

/* ============ 基础样式 ============ */
QMainWindow {
    background-color: #ffffff;
}

/* ============ 菜单栏样式 ============ */
QMenuBar {
    background-color: transparent;
    spacing: 4px;
}

QMenuBar::item {
    padding: 5px 8px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: rgba(0, 0, 0, 0.06);
    border-radius: 4px;
}

/* 菜单下拉样式 */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 32px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: rgba(52, 152, 219, 0.1);
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 14px;
    color: #2c3e50;
}

/* ============ 侧边栏样式 ============ */
QWidget#sidebar_header {
    background-color: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
}

QLabel#app_title {
    color: #2c3e50;
    background-color: transparent;
}

QLabel#app_subtitle {
    color: #7f8c8d;
    background-color: transparent;
}

QFrame#sidebar_separator {
    background-color: #e0e0e0;
    max-height: 1px;
    border: none;
}

/* 导航按钮 */
QPushButton#nav_button {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    color: #2c3e50;
}

QPushButton#nav_button:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QPushButton#nav_button:checked {
    background-color: rgba(52, 152, 219, 0.1);
    border-left-color: #3498db;
    color: #3498db;
    font-weight: bold;
}

/* 新建对话按钮 (顶部) */
QPushButton#new_chat_button_top {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 12px 12px 16px;
    font-size: 14px;
    font-weight: bold;
    margin: 8px 12px;
    text-align: left;
}

QPushButton#new_chat_button_top:hover {
    background-color: #2980b9;
}

QPushButton#new_chat_button_top:pressed {
    background-color: #21618c;
}

/* 对话历史列表 */
QListWidget#chat_history_list {
    border: none;
    background-color: transparent;
    outline: none;
}

QListWidget#chat_history_list::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #2c3e50;
}

QListWidget#chat_history_list::item:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QListWidget#chat_history_list::item:selected {
    background-color: rgba(52, 152, 219, 0.15);
    color: #3498db;
}

/* 底部用户信息 */
QWidget#sidebar_footer {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
}

QPushButton#user_avatar_button {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

QPushButton#user_avatar_button:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

QLabel#user_info {
    color: #2c3e50;
    background-color: transparent;
}

/* 对话历史标题 */
QLabel#history_title {
    color: #7f8c8d;
    background-color: transparent;
    font-size: 12px;
    font-weight: bold;
}

/* ============ 折叠/展开按钮样式 (Claude 风格) ============ */
QWidget#toggle_sidebar_container {
    background-color: transparent;
}

QPushButton#toggle_sidebar_button {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 0px;
}

QPushButton#toggle_sidebar_button:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

QPushButton#toggle_sidebar_button:pressed {
    background-color: rgba(0, 0, 0, 0.1);
}

/* ============ 菜单栏工具按钮样式 ============ */
QWidget#menubar_left_tools {
    background-color: transparent;
}

QPushButton#menubar_tool_button {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

QPushButton#menubar_tool_button:hover {
    background-color: rgba(0, 0, 0, 0.06);
}

QPushButton#menubar_tool_button:pressed {
    background-color: rgba(0, 0, 0, 0.1);
}

/* 隐藏菜单下拉箭头指示器 */
QPushButton#menubar_tool_button::menu-indicator {
    width: 0;
    height: 0;
    image: none;
}

/* ============ 主内容区样式 ============ */
QWidget#main_content_stack {
    background-color: #ffffff;
}

/* ============ AI 对话页面样式 (现代风格改进版) ============ */

/* === 整体背景 === */
QWidget#chat_page {
    background-color: #f8f9fa;
}

/* === 顶部标题栏 === */
QWidget#chat_header {
    background-color: #ffffff;
    border-bottom: 1px solid #e9ecef;
}

QLabel#chat_title {
    color: #1a1a1a;
    font-size: 22px;
    font-weight: 600;
    background-color: transparent;
}

QPushButton#new_chat_button {
    background-color: #f8f9fa;
    color: #495057;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#new_chat_button:hover {
    background-color: #e9ecef;
    border-color: #adb5bd;
}

QPushButton#new_chat_button:pressed {
    background-color: #dee2e6;
}

/* === 消息展示区域 === */
QScrollArea#messages_scroll {
    border: none;
    background-color: #f8f9fa;
}

QWidget#messages_container {
    background-color: #f8f9fa;
}

QWidget#message_row {
    background-color: transparent;
}

/* === 消息气泡容器 === */
QWidget#bubble_container_user,
QWidget#bubble_container_assistant {
    background-color: transparent;
}

/* === 角色标签 === */
QLabel#role_icon {
    font-size: 18px;
    background-color: transparent;
}

QLabel#role_name_user {
    color: #495057;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
}

QLabel#role_name_assistant {
    color: #495057;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
}

/* === 用户消息气泡 === */
QWidget#message_bubble_user {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea,
        stop:1 #764ba2
    );
    border-radius: 16px;
    border: none;
}

QLabel#content_user {
    color: #ffffff;
    font-size: 15px;
    line-height: 1.6;
    background-color: transparent;
}

/* === AI 助手消息气泡 === */
QWidget#message_bubble_assistant {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #e9ecef;
}

QLabel#content_assistant {
    color: #212529;
    font-size: 15px;
    line-height: 1.6;
    background-color: transparent;
}

/* === 输入区域容器 === */
QWidget#input_container {
    background-color: #ffffff;
    border-top: 1px solid #e9ecef;
}

/* === 输入框包装器(阴影效果) === */
QWidget#input_wrapper {
    background-color: transparent;
}

/* === 输入框 === */
QTextEdit#message_input {
    border: 2px solid #e9ecef;
    border-radius: 12px;
    padding: 14px 16px;
    background-color: #ffffff;
    font-size: 15px;
    color: #212529;
    selection-background-color: #667eea;
    selection-color: #ffffff;
}

QTextEdit#message_input:focus {
    border: 2px solid #667eea;
    background-color: #ffffff;
}

QTextEdit#message_input:hover {
    border-color: #adb5bd;
}

/* === 提示文字 === */
QLabel#input_hint {
    color: #6c757d;
    font-size: 13px;
    background-color: transparent;
}

/* === 发送按钮 === */
QPushButton#send_button {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea,
        stop:1 #764ba2
    );
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 32px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#send_button:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5568d3,
        stop:1 #6439a0
    );
}

QPushButton#send_button:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4a5bbf,
        stop:1 #592f8e
    );
}

QPushButton#send_button:disabled {
    background: #e9ecef;
    color: #adb5bd;
}

/* ============ 技能教学页面样式 ============ */
QLabel#recording_title {
    color: #1a1a2e;
    background-color: transparent;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #ddd;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    color: #2c3e50;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 6px 8px;
    background-color: white;
    font-size: 14px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #5b6abf;
}

/* ============ 技能列表页面样式 ============ */
QLabel#tools_title {
    color: #1a1a2e;
    background-color: transparent;
}

/* ============ 设置页面样式 ============ */
QLabel#settings_title {
    color: #2c3e50;
    background-color: transparent;
}

QGroupBox#settings_group {
    font-weight: bold;
    border: 1px solid #ddd;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    color: #2c3e50;
}

QLineEdit#settings_input,
QComboBox#settings_combo,
QSpinBox#settings_spin {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 6px 8px;
    background-color: white;
    font-size: 14px;
}

QLineEdit#settings_input:focus,
QComboBox#settings_combo:focus,
QSpinBox#settings_spin:focus {
    border: 1px solid #3498db;
}

QPushButton#settings_save_button {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 32px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#settings_save_button:hover {
    background-color: #2980b9;
}

/* ============ 通用按钮样式 ============ */
QPushButton {
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: #e0e0e0;
}

QPushButton:pressed {
    background-color: #d0d0d0;
}

/* ============ 滚动条样式 ============ */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #bdc3c7;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #95a5a6;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #bdc3c7;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #95a5a6;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* ============ Intent 确认 UI 样式 ============ */

/* === 状态栏 === */
QWidget#intent_status_bar {
    background-color: #f8f9fa;
    border-bottom: 1px solid #e9ecef;
}

QLabel#status_icon {
    font-size: 20px;
    background-color: transparent;
}

QLabel#status_label {
    color: #495057;
    font-size: 15px;
    font-weight: 500;
    background-color: transparent;
}

/* === 左右面板 === */
QWidget#intent_left_panel,
QWidget#intent_right_panel {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 8px;
}

QLabel#intent_section_title {
    color: #212529;
    font-size: 18px;
    font-weight: 600;
    background-color: transparent;
    padding-bottom: 8px;
    border-bottom: 2px solid #e9ecef;
}

QLabel#intent_subsection_title {
    color: #495057;
    font-size: 15px;
    font-weight: 600;
    background-color: transparent;
    margin-top: 12px;
}

QLabel#intent_info_label {
    color: #495057;
    font-size: 14px;
    background-color: #f8f9fa;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid #e9ecef;
}

QLabel#intent_result_label {
    color: #6c757d;
    font-size: 13px;
    background-color: transparent;
    padding: 4px 0;
}

QLabel#intent_loading_label {
    color: #6c757d;
    font-size: 14px;
    font-style: italic;
    background-color: transparent;
    padding: 40px 20px;
}

QLabel#intent_hint_label {
    color: #6c757d;
    font-size: 13px;
    background-color: transparent;
    padding: 8px 12px;
    border: 1px dashed #dee2e6;
    border-radius: 6px;
}

QFrame#intent_separator {
    background-color: #e9ecef;
    max-height: 1px;
    border: none;
    margin: 8px 0;
}

/* === 操作勾选框 === */
QCheckBox#intent_operation_checkbox {
    color: #212529;
    font-size: 14px;
    spacing: 8px;
    padding: 10px 12px;
    background-color: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 6px;
}

QCheckBox#intent_operation_checkbox:hover {
    background-color: #e9ecef;
}

QCheckBox#intent_operation_checkbox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #adb5bd;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox#intent_operation_checkbox::indicator:hover {
    border-color: #667eea;
}

QCheckBox#intent_operation_checkbox::indicator:checked {
    background-color: #667eea;
    border-color: #667eea;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTgiIGhlaWdodD0iMTgiIHZpZXdCb3g9IjAgMCAxOCAxOCIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj4KPHBhdGggZD0iTTE1IDZMNi41IDE0LjVMMyAxMSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz4KPC9zdmc+);
}

/* === 对话框消息区域 === */
QScrollArea#intent_messages_scroll {
    border: none;
    background-color: #f8f9fa;
}

QWidget#intent_messages_container {
    background-color: #f8f9fa;
}

QWidget#intent_message_row_user,
QWidget#intent_message_row_assistant {
    background-color: transparent;
}

/* 用户消息气泡 */
QWidget#intent_message_bubble_user {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea,
        stop:1 #764ba2
    );
    border-radius: 12px;
    border: none;
}

QLabel#intent_message_content_user {
    color: #ffffff;
    font-size: 14px;
    line-height: 1.5;
    background-color: transparent;
}

/* AI 助手消息气泡 */
QWidget#intent_message_bubble_assistant {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e9ecef;
}

QLabel#intent_message_content_assistant {
    color: #212529;
    font-size: 14px;
    line-height: 1.5;
    background-color: transparent;
}

/* === 输入区域 === */
QWidget#intent_input_container {
    background-color: transparent;
}

QTextEdit#intent_message_input {
    border: 2px solid #e9ecef;
    border-radius: 8px;
    padding: 12px;
    background-color: #ffffff;
    font-size: 14px;
    color: #212529;
}

QTextEdit#intent_message_input:focus {
    border: 2px solid #667eea;
}

QLabel#intent_input_hint {
    color: #6c757d;
    font-size: 12px;
    background-color: transparent;
}

/* === 确认问题样式（气泡内） === */
QLabel#confirmation_question_label {
    color: #212529;
    font-size: 14px;
    line-height: 1.5;
    background-color: transparent;
}

QLabel#confirmation_context_label {
    color: #6c757d;
    font-size: 12px;
    font-style: italic;
    background-color: transparent;
    padding: 4px 0;
}

QWidget#confirmation_options_container {
    background-color: transparent;
}

/* 确认选项按钮 */
QPushButton#confirmation_option_button {
    background-color: #f8f9fa;
    color: #212529;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
    text-align: left;
}

QPushButton#confirmation_option_button:hover {
    background-color: #e9ecef;
    border-color: #adb5bd;
}

QPushButton#confirmation_option_button:checked {
    background-color: #e3f2fd;
    border-color: #2196f3;
    color: #1565c0;
}

/* 选项影响说明 */
QLabel#confirmation_impact_label {
    color: #6c757d;
    font-size: 12px;
    background-color: transparent;
    padding-left: 4px;
}

/* 问题分隔线 */
QFrame#question_separator {
    background-color: #e9ecef;
    max-height: 1px;
    border: none;
    margin: 8px 0;
}

/* === 确认按钮卡片 === */
QLabel#confirm_progress_label {
    font-size: 14px;
    background-color: transparent;
    padding: 4px 0;
}

QPushButton#confirm_tool_button:disabled {
    background: #e9ecef;
    color: #adb5bd;
}

/* === 分析摘要样式 === */
QLabel#confirmation_message_label {
    color: #212529;
    font-size: 14px;
    line-height: 1.6;
    background-color: transparent;
}

QLabel#summary_item_label {
    color: #495057;
    font-size: 13px;
    background-color: transparent;
    padding: 2px 0;
}

QLabel#summary_desc_label {
    color: #212529;
    font-size: 13px;
    line-height: 1.5;
    background-color: transparent;
    padding: 8px 0;
}

QPushButton#confirm_tool_button {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2ecc71,
        stop:1 #27ae60
    );
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#confirm_tool_button:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #27ae60,
        stop:1 #229954
    );
}

QPushButton#confirm_tool_button:disabled {
    background: #e9ecef;
    color: #adb5bd;
}

QPushButton#intent_send_button {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #667eea,
        stop:1 #764ba2
    );
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#intent_send_button:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5568d3,
        stop:1 #6439a0
    );
}

QPushButton#intent_send_button:disabled {
    background: #e9ecef;
    color: #adb5bd;
}

/* === 底部操作栏 === */
QWidget#intent_bottom_bar {
    background-color: #ffffff;
    border-top: 1px solid #e9ecef;
}

QPushButton#intent_cancel_button {
    background-color: #f8f9fa;
    color: #6c757d;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#intent_cancel_button:hover {
    background-color: #e9ecef;
    border-color: #adb5bd;
}

QPushButton#intent_confirm_button {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2ecc71,
        stop:1 #27ae60
    );
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
}

QPushButton#intent_confirm_button:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #27ae60,
        stop:1 #229954
    );
}

QPushButton#intent_confirm_button:disabled {
    background: #e9ecef;
    color: #adb5bd;
}

/* === 滚动区域 === */
QScrollArea#intent_scroll_area {
    border: none;
    background-color: transparent;
}

QWidget#intent_options_container {
    background-color: transparent;
}

/* ============ 技能列表 UI 样式（卡片样式由组件内联管理）============ */

