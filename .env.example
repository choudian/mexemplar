# 环境配置示例文件
# 复制此文件为 .env 并根据需要修改

# 运行环境：development（开发）或 production（生产）
# development: 自动创建表（Base.metadata.create_all()）
# production: 依赖 Alembic 迁移脚本
ENV=development

# DuckDB 数据库路径（可选，默认使用 data/recordings/exemplar.duckdb）
# DUCKDB_PATH=/path/to/your/database.duckdb

# SQLAlchemy 日志（开发调试用）
# SQL_ECHO=true
