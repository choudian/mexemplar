{
  "app_name": "Mexemplar",
  "version": "0.1.0",
  "env": {},
  "ai": {
    "provider": "openai",
    "model": "GLM-5.1",
    "api_key": "",
    "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
    "temperature": 0.7,
    "max_tokens": 4096,
    "timeout": 180,
    "retry_max_retries": 3,
    "retry_delay": 1.0,
    "thinking_level": "off",
    "vision_model": "claude-3-5-sonnet-20241022",
    "vision_provider": null,
    "vision_api_key": null,
    "vision_base_url": null,
    "embedding_api_key": null,
    "compression_model_temperature": 0.5,
    "compression_model_max_tokens": 1024,
    "memory_reference_steps_threshold": 3,
    "memory_reference_size_threshold": 10000,
    "memory_compression_token_threshold": 80000,
    "memory_compression_count_threshold": null,
    "memory_compression_keep_recent": 20,
    "memory_compression_trigger_strategy": "token",
    "memory_tool_result_group_budget": 24000
  },
  "recording": {
    "screenshot_quality": 85,
    "screenshot_delay_after_action": 0.2,
    "browser_start_url": null,
    "noise_filter": {
      "enabled": true,
      "blacklist_domains": [
        "doubleclick",
        "googletagmanager",
        "google-analytics",
        "sentry",
        "hotjar",
        "baidu-tongji"
      ],
      "first_party_whitelist": [],
      "static_extensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".gif",
        ".svg",
        ".webp",
        ".ico",
        ".css",
        ".woff",
        ".woff2",
        ".ttf",
        ".otf",
        ".eot"
      ],
      "static_content_type_prefixes": [
        "image/",
        "font/",
        "text/css",
        "application/font-woff",
        "application/octet-stream"
      ]
    },
    "persistent_user_data": true,
    "user_data_dir": null,
    "websocket": {
      "host": "127.0.0.1",
      "port": 8765,
      "max_message_size": 52428800,
      "max_response_body_size": 5242880
    },
    "proxy": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "large_field": {
      "threshold_chars": 1000,
      "preview_chars": 1000,
      "max_chunk_chars": 1000
    },
    "desktop": {
      "enable_clip": true,
      "vision_model": null
    }
  },
  "ui": {
    "theme": "light",
    "density": "comfy",
    "accent": "",
    "radius": "medium"
  },
  "web": {
    "search_backend": "auto",
    "brave_api_key": null
  },
  "skill_store": {
    "skills_sh_api_key": null
  },
  "brain": {
    "segment": {
      "idle_threshold_seconds": 300,
      "max_distillation_retries": 3
    },
    "worker": {
      "tick_interval_seconds": 300,
      "prediction_verification_retries": 3
    },
    "injection": {
      "persistent_top_n": 50,
      "hot_zone_top_n": 20,
      "subconscious_top_n": 10
    },
    "decay": {
      "fading_threshold": 0.3
    },
    "recruitment": {
      "min_delegation_count": 5
    },
    "skill": {
      "token_budget": {
        "warn_threshold": 4096,
        "danger_threshold": 8192
      },
      "seed_file_path": "src/business/brain/seed/how_to_create_skill_methodology.md"
    }
  },
  "assistant_tasks": {
    "unified_dispatch": {
      "enabled": true
    },
    "cutover": {
      "clean_start_guard": true
    },
    "dispatch": {
      "max_workers": 4
    },
    "graph": {
      "max_tasks": 200
    },
    "board": {
      "capacity": 50,
      "fallback_seconds": 60
    },
    "recruitment": {
      "min_fallback_count": 3
    },
    "attempt": {
      "lease_seconds": 120
    },
    "recovery": {
      "scan_interval_seconds": 30
    },
    "meeting": {
      "turn_budget": 12,
      "time_budget_seconds": 900,
      "mutual_wait_window": 4
    },
    "api": {
      "default_limit": 50
    },
    "complexity": {
      "step_threshold": 3,
      "domain_threshold": 2
    },
    "planner": {
      "specialist_name": "planner"
    }
  },
  "external_coding": {
    "enabled": true,
    "default_launch_mode": "headless",
    "preferred_tool": "auto",
    "artifact_root": "data/coding_sessions",
    "worktree_root": ".worktrees/coding",
    "log_tail_chars": 8000,
    "plan_timeout_seconds": 1800,
    "run_timeout_seconds": 7200,
    "autostart_enabled": true,
    "quota_probe": {
      "enabled": true,
      "timeout_seconds": 12,
      "low_threshold_percent": 80
    },
    "claude": {
      "command": "claude",
      "effort": "max"
    },
    "codex": {
      "command": "codex",
      "reasoning_effort": "xhigh"
    }
  },
  "agent_tools": {
    "file": {
      "default_max_lines": 200,
      "max_window_chars": 50000,
      "max_decode_bytes": 1048576
    },
    "output": {
      "visible_char_cap": 12000,
      "raw_reference_threshold_chars": 20000,
      "max_artifact_bytes": 10485760,
      "retention_days": 14,
      "load_max_bytes": 131072,
      "semantic_summary": {
        "enabled": true,
        "provider": "anthropic",
        "model": "",
        "base_url": "",
        "api_key": "",
        "temperature": 0.2,
        "trigger_chars": 20000,
        "max_input_chars": 120000,
        "chunk_chars": 20000,
        "max_map_chunks": 6,
        "map_concurrency": 3,
        "total_timeout_seconds": 12,
        "map_max_tokens": 500,
        "reduce_max_tokens": 900,
        "summary_max_chars": 4000
      }
    },
    "search": {
      "default_page_size": 100,
      "max_files_scanned": 50000,
      "max_bytes_per_file": 1048576,
      "max_elapsed_ms": 30000
    },
    "process": {
      "default_timeout_ms": 30000,
      "max_timeout_ms": 600000,
      "log_tail_chars": 4000,
      "max_background_processes": 16,
      "event_buffer_size": 64,
      "stalled_threshold_ms": 10000,
      "chunk_threshold_chars": 4096
    },
    "discovery": {
      "full_catalog_max_items": 20,
      "full_catalog_max_chars": 6000,
      "search_default_limit": 10,
      "search_max_limit": 25,
      "result_description_max_chars": 500
    },
    "delegation": {
      "context_expansion_max_chars": 30000
    },
    "max_parallel_workers": 4
  },
  "scheduler": {
    "scan_interval_seconds": 30,
    "confirmation_timeout_seconds": 300
  },
  "self_improvement": {
    "max_prompt_supplements_per_day": 3,
    "max_tool_creations_per_day": 1,
    "max_reflections_per_session": 5,
    "convergence_threshold": 0.01,
    "degradation_threshold": 0.1,
    "sandbox_window": 20,
    "rollback_monitor_window": 10,
    "avoidance_top_n": 5,
    "tool_gap_threshold": 3,
    "execution_review": {
      "enabled": true,
      "model": {
        "provider": null,
        "model": null,
        "api_key": null,
        "base_url": null,
        "temperature": null,
        "max_tokens": null,
        "thinking_level": null,
        "timeout": null
      },
      "max_per_session": 3
    },
    "proposals": {
      "enabled": true,
      "worktree_retention_max": 10,
      "dedup_cooldown_hours": 24
    }
  }
}
