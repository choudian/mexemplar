{
  "app_name": "Mexemplar",
  "version": "0.1.0",
  "debug": false,
  "ai": {
    "provider": "openai",
    "model": "GLM-5.1",
    "api_key": "",
    "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
    "temperature": 0.7,
    "max_tokens": 4096,
    "timeout": 180,
    "retry_max_retries": 3,
    "retry_delay": 1.0,
    "thinking_level": "off",
    "vision_model": "claude-3-5-sonnet-20241022",
    "vision_provider": null,
    "vision_api_key": null,
    "vision_base_url": null,
    "embedding_api_key": null,
    "compression_model_provider": "anthropic",
    "compression_model_name": "claude-3-5-haiku-20241022",
    "compression_model_api_key": null,
    "compression_model_base_url": null,
    "compression_model_temperature": 0.5,
    "compression_model_max_tokens": 1024,
    "memory_reference_steps_threshold": 3,
    "memory_reference_size_threshold": 10000,
    "memory_compression_token_threshold": 80000,
    "memory_compression_count_threshold": null,
    "memory_compression_keep_recent": 20,
    "memory_compression_trigger_strategy": "token"
  },
  "recording": {
    "screenshot_quality": 85,
    "screenshot_delay_after_action": 0.2,
    "enable_video_recording": true,
    "video_fps": 15,
    "video_quality": 85,
    "record_mouse_move": false,
    "default_recording_mode": "browser",
    "browser_type": "chromium",
    "browser_headless": false,
    "browser_start_url": null,
    "capture_network_requests": true,
    "network_request_filter": "xhr_fetch",
    "network_request_timeout": 5.0,
    "noise_filter": {
      "enabled": true,
      "blacklist_domains": [
        "doubleclick",
        "googletagmanager",
        "google-analytics",
        "sentry",
        "hotjar",
        "baidu-tongji"
      ],
      "first_party_whitelist": [],
      "static_extensions": [
        ".png",
        ".jpg",
        ".jpeg",
        ".gif",
        ".svg",
        ".webp",
        ".ico",
        ".css",
        ".woff",
        ".woff2",
        ".ttf",
        ".otf",
        ".eot"
      ],
      "static_content_type_prefixes": [
        "image/",
        "font/",
        "text/css",
        "application/font-woff",
        "application/octet-stream"
      ]
    },
    "persistent_user_data": true,
    "user_data_dir": null,
    "websocket": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8765,
      "ping_interval": 30.0,
      "max_reconnect_attempts": 10,
      "reconnect_delay": 1.0,
      "message_queue_size": 1000,
      "max_message_size": 52428800,
      "max_response_body_size": 5242880
    },
    "proxy": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "large_field": {
      "threshold_chars": 1000,
      "preview_chars": 1000,
      "max_chunk_chars": 1000
    },
    "desktop": {
      "enable_clip": true,
      "vision_model": null
    }
  },
  "ui": {
    "theme": "light",
    "density": "comfy",
    "language": "zh_CN",
    "window_width": 1200,
    "window_height": 800
  },
  "web": {
    "search_backend": "auto",
    "brave_api_key": null
  },
  "brain": {
    "segment": {
      "idle_threshold_seconds": 300,
      "max_distillation_retries": 3
    },
    "worker": {
      "tick_interval_seconds": 300,
      "prediction_verification_retries": 3
    },
    "injection": {
      "hot_zone_top_n": 20,
      "subconscious_top_n": 10
    },
    "decay": {
      "fading_threshold": 0.3
    },
    "recruitment": {
      "min_delegation_count": 5
    },
    "skill": {
      "token_budget": {
        "warn_threshold": 4096,
        "danger_threshold": 8192
      },
      "seed_file_path": "src/business/brain/seed/how_to_create_skill_methodology.md"
    }
  },
  "assistant_tasks": {
    "unified_dispatch": {
      "enabled": true
    },
    "cutover": {
      "clean_start_guard": true
    },
    "dispatch": {
      "max_workers": 4
    },
    "graph": {
      "max_tasks": 200
    },
    "board": {
      "capacity": 50,
      "fallback_seconds": 60
    },
    "recruitment": {
      "min_fallback_count": 3
    },
    "attempt": {
      "lease_seconds": 120
    },
    "recovery": {
      "scan_interval_seconds": 30
    },
    "meeting": {
      "turn_budget": 12,
      "time_budget_seconds": 900,
      "mutual_wait_window": 4
    },
    "api": {
      "default_limit": 50
    }
  },
  "agent_tools": {
    "file": {
      "default_max_lines": 200,
      "max_window_chars": 50000,
      "max_decode_bytes": 1048576
    },
    "output": {
      "visible_char_cap": 12000,
      "raw_reference_threshold_chars": 20000,
      "max_artifact_bytes": 10485760,
      "retention_days": 14,
      "semantic_summary": {
        "enabled": true,
        "provider": "anthropic",
        "model": "",
        "base_url": "",
        "api_key": "",
        "temperature": 0.2,
        "trigger_chars": 20000,
        "max_input_chars": 120000,
        "chunk_chars": 20000,
        "max_map_chunks": 6,
        "map_concurrency": 3,
        "total_timeout_seconds": 12,
        "map_max_tokens": 500,
        "reduce_max_tokens": 900,
        "summary_max_chars": 4000
      }
    },
    "search": {
      "default_page_size": 100,
      "max_files_scanned": 50000,
      "max_bytes_per_file": 1048576,
      "max_elapsed_ms": 30000
    },
    "process": {
      "default_timeout_ms": 30000,
      "max_timeout_ms": 600000,
      "log_tail_chars": 4000,
      "max_background_processes": 16
    },
    "discovery": {
      "full_catalog_max_items": 20,
      "full_catalog_max_chars": 6000,
      "search_default_limit": 10,
      "search_max_limit": 25,
      "result_description_max_chars": 500
    }
  },
  "self_improvement": {
    "proposals": {
      "enabled": true,
      "worktree_retention_max": 10,
      "dedup_cooldown_hours": 24
    }
  }
}
